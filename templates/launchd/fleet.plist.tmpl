<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>{{LABEL}}</string>

    <!-- The script lives in the kit checkout; the fleet it starts may live
         somewhere else entirely (setup.sh --root). Those are two different
         directories, so ProgramArguments must name the checkout and
         FLEET_ROOT below must name the fleet. Pointing both at the fleet
         root produces a plist launchd loads without complaint and a fleet
         that never starts. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>{{KIT_BIN}}/fleet-start.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>FLEET_ROOT</key>
        <string>{{FLEET_ROOT}}</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <!-- KeepAlive must stay false. fleet-start.sh runs once and exits; the
         agents it launched keep running under tmux. With KeepAlive true,
         launchd would treat that normal exit as a crash and restart the whole
         fleet in a loop. -->
    <key>KeepAlive</key>
    <false/>

    <!-- The tmux server and the watcher outlive this script. Without this,
         launchd reaps the whole process group when the script exits and the
         fleet dies seconds after starting. -->
    <key>AbandonProcessGroup</key>
    <true/>

    <key>StandardOutPath</key>
    <string>{{LOG_DIR}}/fleet-start.log</string>
    <key>StandardErrorPath</key>
    <string>{{LOG_DIR}}/fleet-start.log</string>
</dict>
</plist>
